# Copy this file to `.env.local` and fill in your key.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# No key is required for MBFC source-credibility lookups — the curated
# Media Bias/Fact Check dataset ships in lib/mbfc.ts.

# --- Optional: cost controls for a public deployment ---
# These protect your API bill when the app is hosted on a public URL.
# All are optional; the defaults below apply when unset.
# RATE_IP_PER_MIN=8        # max analyses per IP per minute
# RATE_IP_PER_DAY=40       # max analyses per IP per day
# RATE_GLOBAL_PER_DAY=500  # hard daily cap across all users (budget kill-switch)

# --- Optional: live claim verification ---
# Max Anthropic web searches per analysis (verifies recent claims with real
# search results). Each search is billed by Anthropic on top of tokens.
# WEB_SEARCH_MAX_USES=3    # set 0 to disable web search entirely
